        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isSchoolTeacherOrStaff(incoming().schoolId) &&
        matchesSchoolOwnerUid(incoming().schoolId, incoming().schoolOwnerUid);
      allow update: if isValidResearchArticle(incoming()) &&
        isValidId(articleId) &&
        incoming().id == existing().id &&
        incoming().schoolId == existing().schoolId &&
        incoming().schoolOwnerUid == existing().schoolOwnerUid &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isPlatformAdmin() ||
          (
            (existing().authorUid == request.auth.uid || isSchoolStaffAdmin(existing().schoolId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'subtitle', 'abstract', 'authors', 'category', 'keywords',
              'status', 'sections', 'references', 'isOpenToPublic',
              'viewsCount', 'downloadsCount', 'citationsCount', 'updatedByUid', 'updatedAt'
            ])
          ) ||
          (
            existing().isOpenToPublic == true &&
            (incoming().viewsCount == existing().viewsCount || incoming().viewsCount == existing().viewsCount + 1) &&
            (incoming().downloadsCount == existing().downloadsCount || incoming().downloadsCount == existing().downloadsCount + 1) &&
            (incoming().citationsCount == existing().citationsCount || incoming().citationsCount == existing().citationsCount + 1) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'viewsCount', 'downloadsCount', 'citationsCount', 'updatedByUid', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(articleId) && (isPlatformAdmin() || isSchoolStaffAdmin(existing().schoolId));
    }
  }
}
